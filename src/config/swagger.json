{
  "openapi": "3.0.0",
  "info": {
    "title": "API Backend Ambilin",
    "version": "1.0.0",
    "description": "Dokumentasi API untuk aplikasi manajemen pengambilan sampah"
  },
  "servers": [
    {
      "url": "https://ambilin.kodetalma.my.id",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Registrasi user baru",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama": { "type": "string", "example": "Tunggul" },
                  "email": { "type": "string", "example": "tunggul@gmail.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registrasi berhasil" },
          "400": {
            "description": "Input tidak valid atau Email sudah terdaftar"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "tunggul@gmail.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login berhasil" },
          "400": { "description": "Password salah" },
          "404": { "description": "User tidak ditemukan" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Refresh Access Token",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Refresh token berhasil" },
          "401": { "description": "Refresh token dibutuhkan" },
          "403": { "description": "Refresh token tidak valid atau kadaluarsa" }
        }
      }
    },
    "/api/auth/logout": {
      "delete": {
        "summary": "Logout user",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logout berhasil" },
          "401": { "description": "Akses ditolak, token tidak ditemukan" }
        }
      }
    },
    "/api/profile": {
      "get": {
        "summary": "Mendapatkan profil data lengkap berdasarkan user yang login",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Berhasil Mendapatkan Data Profil",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Berhasil mendapatkan data profil",
                  "data": {
                    "id_user": 12,
                    "nama": "Budi Santoso",
                    "email": "budi@gmail.com",
                    "id_role": 3,
                    "foto": "https://res.cloudinary.com/.../profile.jpg",
                    "alamat": "Jl. Mastrip No. 164, Jember",
                    "nomor_telepon": "081234567890",
                    "latitude": "-8.123456",
                    "longitude": "113.123456",
                    "customer_profile": {
                      "id_customer": 2,
                      "poin": 150,
                      "is_member": false,
                      "is_aktif": true,
                      "expired_member_date": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Token tidak dikirim atau sudah kadaluarsa"
          },
          "404": { "description": "Not Found - User tidak ditemukan" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "summary": "Memperbarui data profil user (Nama, No Telp, Alamat, Koordinat)",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama": { "type": "string", "example": "Budi Santoso Edit" },
                  "nomor_telepon": {
                    "type": "string",
                    "example": "081222333444"
                  },
                  "alamat": {
                    "type": "string",
                    "example": "Jl. Kalimantan No. 37, Jember"
                  },
                  "latitude": { "type": "string", "example": "-8.156789" },
                  "longitude": { "type": "string", "example": "113.712345" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profil berhasil diperbarui",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Profil berhasil diperbarui",
                  "data": {
                    "nama": "Budi Santoso Edit",
                    "nomor_telepon": "081222333444",
                    "alamat": "Jl. Kalimantan No. 37, Jember",
                    "latitude": "-8.156789",
                    "longitude": "113.712345"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Token tidak dikirim atau sudah kadaluarsa"
          },
          "404": { "description": "Not Found - User tidak ditemukan" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/profile/photo": {
      "put": {
        "summary": "Memperbarui/Mengganti foto profil user (Khusus Unggah Gambar)",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "foto": {
                    "type": "string",
                    "format": "binary",
                    "description": "File gambar profil baru (jpg/png)"
                  }
                },
                "required": ["foto"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Foto profil berhasil diperbarui",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Foto profil berhasil diperbarui",
                  "data": {
                    "foto": "https://res.cloudinary.com/dbhycng5p/image/upload/v1778269675/ambilin/avatars/user_12.png"
                  }
                }
              }
            }
          },
          "400": { "description": "File foto wajib diunggah" },
          "401": {
            "description": "Unauthorized - Token tidak ditemukan atau expired"
          },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/manajemen-akun": {
      "get": {
        "summary": "Mendapatkan daftar seluruh akun (Bisa difilter lewat query role)",
        "tags": ["Admin (Manajemen Akun)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "description": "Saring berdasarkan ID Role: 2 (Petugas) atau 3 (Customer)",
            "required": false,
            "schema": { "type": "integer", "example": 2 }
          }
        ],
        "responses": {
          "200": { "description": "Berhasil mendapatkan daftar akun" },
          "401": {
            "description": "Unauthorized - Token tidak dikirim atau expired"
          },
          "403": { "description": "Forbidden - Khusus Admin Role 1" }
        }
      },
      "post": {
        "summary": "Membuat akun Petugas atau Customer baru langsung dari Panel Admin",
        "tags": ["Admin (Manajemen Akun)"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_role": {
                    "type": "integer",
                    "description": "2 untuk Petugas, 3 untuk Customer",
                    "example": 2
                  },
                  "nama": { "type": "string", "example": "Driver Jono" },
                  "email": { "type": "string", "example": "jono@example.com" },
                  "nomor_telepon": {
                    "type": "string",
                    "example": "0812345678"
                  },
                  "password": { "type": "string", "example": "password123" }
                },
                "required": ["id_role", "nama", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Akun baru berhasil dibuat oleh Admin" },
          "400": {
            "description": "Email sudah terdaftar atau input tidak lengkap"
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/manajemen-akun/{id_user}": {
      "put": {
        "summary": "Memperbarui data dasar user (Nama, Email, Telepon) lewat panel Admin",
        "tags": ["Admin (Manajemen Akun)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id_user",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID User yang akan dimodifikasi"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama": { "type": "string", "example": "Driver Jono Edit" },
                  "email": {
                    "type": "string",
                    "example": "jono_baru@example.com"
                  },
                  "nomor_telepon": { "type": "string", "example": "0855667788" }
                },
                "required": ["nama", "email", "nomor_telepon"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Data user berhasil diperbarui" },
          "400": { "description": "Input data tidak lengkap" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Menonaktifkan akun secara soft delete (Mengubah status is_aktif menjadi 0)",
        "tags": ["Admin (Manajemen Akun)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id_user",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID User yang akan dinonaktifkan"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_role": {
                    "type": "integer",
                    "description": "ID Role user saat ini (2/3)",
                    "example": 2
                  }
                },
                "required": ["id_role"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Akun berhasil dinonaktifkan (Soft Delete)" },
          "400": {
            "description": "id_role wajib disertakan / data tidak ditemukan"
          },
          "412": { "description": "Precondition Failed" }
        }
      }
    },
    "/api/setor": {
      "post": {
        "summary": "Mengajukan setoran sampah baru (Khusus Customer)",
        "tags": ["Setor Sampah"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "alamat": {
                    "type": "string",
                    "example": "Jl. Mastrip No. 164, Jember"
                  },
                  "latitude": { "type": "string", "example": "-8.123456" },
                  "longitude": { "type": "string", "example": "113.123456" },
                  "foto": {
                    "type": "string",
                    "format": "binary",
                    "description": "File gambar sampah (jpg/png)"
                  }
                },
                "required": ["alamat", "foto"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Permintaan setor sampah berhasil dikirim",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Permintaan setor sampah berhasil dikirim",
                  "data": {
                    "id_setor": 15,
                    "foto_url": "https://res.cloudinary.com/demo/image/upload/v1234/ambilin/setor_sampah/example.jpg"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Foto wajib diunggah atau input tidak valid"
          },
          "401": { "description": "Unauthorized" },
          "403": {
            "description": "Forbidden - Hanya role Customer yang diperbolehkan"
          },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}
